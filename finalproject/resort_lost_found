    <script>

document.addEventListener('DOMContentLoaded', function () {

    let publicChart = null;


    async function updateStatistics() {

        try {

            const response = await fetch(
                'index(5).php?ajax=report_stats&_=' + Date.now(),
                {
                    cache: 'no-store'
                }
            );


            const data = await response.json();


            if (!data.success) {

                throw new Error(
                    data.message || 'Statistics API failed.'
                );

            }


            /*
            |--------------------------------------------------------------------------
            | UPDATE NUMBERS
            |--------------------------------------------------------------------------
            */

            document.getElementById(
                'totalLostItems'
            ).textContent = data.totals.lost;


            document.getElementById(
                'totalFoundItems'
            ).textContent = data.totals.found;


            document.getElementById(
                'totalClaimedItems'
            ).textContent = data.totals.claimed;


            document.getElementById(
                'currentlyStoredItems'
            ).textContent = data.totals.stored;


            /*
            |--------------------------------------------------------------------------
            | UPDATE CHART
            |--------------------------------------------------------------------------
            */

            const canvas =
                document.getElementById(
                    'publicStatsChart'
                );


            if (!canvas) {

                throw new Error(
                    'publicStatsChart not found.'
                );

            }


            const ctx =
                canvas.getContext('2d');


            if (publicChart) {

                publicChart.destroy();

            }


            publicChart = new Chart(ctx, {

                type: 'bar',

                data: {

                    labels: data.labels,

                    datasets: [

                        {
                            label: 'Lost Items',

                            data: data.lost,

                            backgroundColor:
                                'rgba(13, 110, 253, 0.7)',

                            borderColor:
                                '#0d6efd',

                            borderWidth: 1,

                            borderRadius: 4
                        },


                        {
                            label: 'Found Items',

                            data: data.found,

                            backgroundColor:
                                'rgba(25, 135, 84, 0.7)',

                            borderColor:
                                '#198754',

                            borderWidth: 1,

                            borderRadius: 4
                        },


                        {
                            label: 'Claimed Items',

                            data: data.claimed,

                            backgroundColor:
                                'rgba(255, 193, 7, 0.8)',

                            borderColor:
                                '#ffc107',

                            borderWidth: 1,

                            borderRadius: 4
                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            position: 'top'
                        },

                        title: {

                            display: true,

                            text:
                                'Lost, Found & Claimed Items - Last 12 Months'

                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            },

                            title: {

                                display: true,

                                text: 'Number of Items'

                            }

                        }

                    }

                }

            });


            /*
            |--------------------------------------------------------------------------
            | UPDATE TIME
            |--------------------------------------------------------------------------
            */

            const timeElement =
                document.getElementById(
                    'reportLastUpdated'
                );


            if (timeElement) {

                timeElement.textContent =
                    'Last updated: ' +
                    new Date().toLocaleTimeString();

            }


        } catch (error) {

            console.error(
                'Real-time statistics error:',
                error
            );


            const timeElement =
                document.getElementById(
                    'reportLastUpdated'
                );


            if (timeElement) {

                timeElement.textContent =
                    'Update failed';

            }

        }

    }


    /*
    |--------------------------------------------------------------------------
    | FIRST LOAD
    |--------------------------------------------------------------------------
    */

    updateStatistics();


    /*
    |--------------------------------------------------------------------------
    | AUTO REFRESH
    |--------------------------------------------------------------------------
    */

    setInterval(
        updateStatistics,
        10000
    );

});

</script>
    
